# Independent inference host/domain; replace domain and certificate paths.
server {
 listen 443 ssl;
 server_name avatar.example.com;
 ssl_certificate /etc/letsencrypt/live/avatar.example.com/fullchain.pem;
 ssl_certificate_key /etc/letsencrypt/live/avatar.example.com/privkey.pem;
 auth_basic "Teacher avatar trial";
 auth_basic_user_file /etc/nginx/avatar-trial.htpasswd;
 add_header Permissions-Policy 'microphone=(self), camera=()' always;
 location / {
  proxy_pass http://127.0.0.1:8282;
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection "upgrade";
  proxy_buffering off;
  proxy_read_timeout 360s;
 }
}
