# 第17版：全新部署时复制为项目根目录的.env后逐项修改。
# 从第15版升级时不要重新填写，直接复制第15版原.env，才能复用数据库、账号、OSS和密钥。
COMPOSE_PROJECT_NAME=geoai_demo_legacy

# 正式域名与备案。
ROOT_DOMAIN=localhost
WWW_DOMAIN=localhost
CLASSROOM_PUBLIC_ORIGIN=https://localhost
LETSENCRYPT_EMAIL=请填写可接收证书通知的邮箱
ICP_APPROVED=YES
SITE_ICP_NUMBER=请填写网站备案号（山西通常为晋ICP备数字号-1）
SITE_POLICE_NUMBER=
SITE_POLICE_RECORD_URL=
SITE_PRIVACY_CONTACT=请填写个人信息保护联系邮箱

# PostgreSQL。从旧版升级时必须保留原值。
POSTGRES_DB=surveying_teacher
POSTGRES_USER=surveying_app
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
PGPOOL_MAX=10

# 首位教师与服务端加密。从旧版升级时必须保留原值。
CLASSROOM_ADMIN_USERNAME=teacher
CLASSROOM_ADMIN_NAME=课程教师
CLASSROOM_ADMIN_PASSWORD=CHANGE_ME_INITIAL_TEACHER_PASSWORD
APP_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_BASE64URL_KEY

# 北京地域私有OSS。从旧版升级时必须保留原值。
STORAGE_DRIVER=oss
OSS_REGION=oss-cn-beijing
OSS_ENDPOINT=https://oss-cn-beijing-internal.aliyuncs.com
OSS_BUCKET=CHANGE_ME_PRIVATE_BUCKET_NAME
ALIBABA_CLOUD_ACCESS_KEY_ID=CHANGE_ME_RAM_ACCESS_KEY_ID
ALIBABA_CLOUD_ACCESS_KEY_SECRET=CHANGE_ME_RAM_ACCESS_KEY_SECRET

# AI服务。使用百炼时填写DASHSCOPE_API_KEY；DEEPSEEK_API_KEY可留空。
AI_PROVIDER=bailian
DASHSCOPE_API_KEY=
BAILIAN_WORKSPACE_ID=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
KB_CHAT_MODEL=qwen-plus
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
LIVEAVATAR_API_KEY=
LIVEAVATAR_DEFAULT_AVATAR_ID=
VOICE_ASR_MODEL=qwen-audio-3.0-asr-flash
VOICE_TTS_MODEL=qwen-audio-3.0-tts-plus
VOICE_TTS_VOICE=longanlingxin
VOICE_TTS_RATE=0.95
